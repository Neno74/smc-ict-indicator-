//@version=6
indicator("SMC Clean Entry – Atwell/ICT", overlay=true, max_lines_count=200, max_labels_count=200)

grp1 = "═══ TREND FILTER ═══"
ema_fast     = input.int(50,    "EMA Fast",           group=grp1, minval=5)
ema_slow     = input.int(200,   "EMA Slow",           group=grp1, minval=20)
show_ema     = input.bool(true, "EMA Linien zeigen",  group=grp1)

grp2 = "═══ ENTRY FILTER ═══"
choch_lookback = input.int(10,    "Swing Lookback",        group=grp2, minval=3, maxval=50)
fvg_min_size   = input.float(0.2, "Min. FVG Größe (%)",    group=grp2, minval=0.0, step=0.1)
vol_mult       = input.float(1.8, "Volumen Multiplikator", group=grp2, minval=1.0, step=0.1)
vol_lookback   = input.int(20,    "Volumen Perioden",      group=grp2, minval=5)
wick_ratio     = input.float(0.55,"Wick Verhältnis",       group=grp2, minval=0.3, step=0.05)

grp3 = "═══ RISK MANAGEMENT ═══"
min_score = input.int(3,     "Mindest Score (1-4)", group=grp3, minval=1, maxval=4)
rr_ratio  = input.float(2.0, "Risk/Reward Ratio",   group=grp3, minval=1.0, step=0.5)
sl_buffer = input.float(0.3, "SL Buffer (%)",       group=grp3, minval=0.1, step=0.1)

grp4 = "═══ ANZEIGE ═══"
show_panel = input.bool(true, "Checklist Panel",  group=grp4)
show_fvg   = input.bool(true, "FVG Zonen zeigen", group=grp4)
show_swing = input.bool(true, "Swing Punkte",     group=grp4)

col_short = color.new(#FF3B3B, 0)
col_long  = color.new(#00E5A0, 0)
col_warn  = color.new(#FF9500, 0)
col_sl    = color.new(#FF3B3B, 30)
col_tp    = color.new(#00E5A0, 30)
col_entry = color.new(#FFD700, 30)
col_ok    = color.new(#00E5A0, 0)
col_no    = color.new(#FF3B3B, 0)
col_neu   = color.new(#8B949E, 0)

ema50  = ta.ema(close, ema_fast)
ema200 = ta.ema(close, ema_slow)

trend_bull = close > ema200 and ema50 > ema200
trend_bear = close < ema200 and ema50 < ema200
trend_neu  = not trend_bull and not trend_bear

plot(show_ema ? ema50  : na, "EMA 50",  color=color.new(#FFD700, 0), linewidth=1)
plot(show_ema ? ema200 : na, "EMA 200", color=color.new(#FF6B6B, 0), linewidth=2)
bgcolor(trend_bull ? color.new(#00E5A0, 97) : trend_bear ? color.new(#FF3B3B, 97) : na)

swing_high = ta.pivothigh(high, choch_lookback, choch_lookback)
swing_low  = ta.pivotlow(low,  choch_lookback, choch_lookback)

var float last_sh = na
var float last_sl = na

if not na(swing_high)
    last_sh := swing_high
if not na(swing_low)
    last_sl := swing_low

if show_swing
    if not na(swing_high)
        label.new(bar_index - choch_lookback, swing_high, "•", color=color.new(#FF6B6B, 0), textcolor=color.new(#FF6B6B, 0), style=label.style_none, size=size.small)
    if not na(swing_low)
        label.new(bar_index - choch_lookback, swing_low, "•", color=color.new(#00E5A0, 0), textcolor=color.new(#00E5A0, 0), style=label.style_none, size=size.small)

choch_bear  = not na(last_sh) and high[choch_lookback] > last_sh and close < last_sh
choch_bull  = not na(last_sl) and low[choch_lookback]  < last_sl and close > last_sl
bos_bear    = not na(last_sh) and close[choch_lookback] > last_sh and close < last_sh
bos_bull    = not na(last_sl) and close[choch_lookback] < last_sl and close > last_sl
struct_bear = choch_bear or bos_bear
struct_bull = choch_bull or bos_bull

fvg_bear_cond = low > high[2] and close[1] < open[1]
fvg_bear_size = fvg_bear_cond ? (low - high[2]) / high[2] * 100 : 0.0
fvg_bull_cond = high < low[2] and close[1] > open[1]
fvg_bull_size = fvg_bull_cond ? (low[2] - high) / low[2] * 100 : 0.0

if show_fvg
    if fvg_bear_cond and fvg_bear_size >= fvg_min_size and trend_bear
        box.new(bar_index - 2, low, bar_index + 8, high[2], border_color=color.new(#FF3B3B, 50), bgcolor=color.new(#FF3B3B, 88), border_width=1, border_style=line.style_dashed, xloc=xloc.bar_index)
    if fvg_bull_cond and fvg_bull_size >= fvg_min_size and trend_bull
        box.new(bar_index - 2, low[2], bar_index + 8, high, border_color=color.new(#00E5A0, 50), bgcolor=color.new(#00E5A0, 88), border_width=1, border_style=line.style_dashed, xloc=xloc.bar_index)

vol_avg        = ta.sma(volume, vol_lookback)
vol_spike_bear = volume > vol_avg * vol_mult and close < open
vol_spike_bull = volume > vol_avg * vol_mult and close > open

candle_range     = high - low
upper_wick       = high - math.max(open, close)
lower_wick       = math.min(open, close) - low
body_size        = math.abs(close - open)
upper_wick_ratio = candle_range > 0 ? upper_wick / candle_range : 0.0
lower_wick_ratio = candle_range > 0 ? lower_wick / candle_range : 0.0
rejection_bear   = upper_wick_ratio >= wick_ratio and close < open and body_size > 0
rejection_bull   = lower_wick_ratio >= wick_ratio and close > open and body_size > 0

score_short = (trend_bear or trend_neu) and not trend_bull ? (struct_bear ? 1 : 0) + (fvg_bear_cond and fvg_bear_size >= fvg_min_size ? 1 : 0) + (vol_spike_bear ? 1 : 0) + (rejection_bear ? 1 : 0) : 0
score_long  = (trend_bull or trend_neu) and not trend_bear ? (struct_bull ? 1 : 0) + (fvg_bull_cond and fvg_bull_size >= fvg_min_size ? 1 : 0) + (vol_spike_bull ? 1 : 0) + (rejection_bull ? 1 : 0) : 0

if score_short >= min_score
    entry_s = close
    sl_s    = not na(last_sh) ? last_sh * (1 + sl_buffer / 100) : high * (1 + sl_buffer / 100)
    risk_s  = sl_s - entry_s
    tp_s    = entry_s - (risk_s * rr_ratio)
    rr_ok_s = risk_s > 0 and (entry_s - tp_s) / risk_s >= rr_ratio
    if rr_ok_s
        label.new(bar_index, high * 1.002, "🔴 SHORT  " + str.tostring(score_short) + "/4", color=color.new(#FF0000, 0), textcolor=color.white, style=label.style_label_down, size=size.normal)
        line.new(bar_index, entry_s, bar_index + 8, entry_s, color=col_entry, width=1, style=line.style_dashed, xloc=xloc.bar_index)
        line.new(bar_index, sl_s, bar_index + 8, sl_s, color=col_sl, width=2, xloc=xloc.bar_index)
        label.new(bar_index + 8, sl_s, "SL " + str.tostring(math.round(sl_s, 2)), color=col_sl, textcolor=color.white, style=label.style_label_left, size=size.small)
        line.new(bar_index, tp_s, bar_index + 8, tp_s, color=col_tp, width=2, xloc=xloc.bar_index)
        label.new(bar_index + 8, tp_s, "TP " + str.tostring(math.round(tp_s, 2)), color=col_tp, textcolor=color.black, style=label.style_label_left, size=size.small)
        box.new(bar_index, sl_s, bar_index + 8, tp_s, border_color=color.new(#FFFFFF, 90), bgcolor=color.new(#FF3B3B, 93), xloc=xloc.bar_index)

if score_long >= min_score
    entry_l = close
    sl_l    = not na(last_sl) ? last_sl * (1 - sl_buffer / 100) : low * (1 - sl_buffer / 100)
    risk_l  = entry_l - sl_l
    tp_l    = entry_l + (risk_l * rr_ratio)
    rr_ok_l = risk_l > 0 and (tp_l - entry_l) / risk_l >= rr_ratio
    if rr_ok_l
        label.new(bar_index, low * 0.998, "🟢 LONG  " + str.tostring(score_long) + "/4", color=color.new(#00C853, 0), textcolor=color.white, style=label.style_label_up, size=size.normal)
        line.new(bar_index, entry_l, bar_index + 8, entry_l, color=col_entry, width=1, style=line.style_dashed, xloc=xloc.bar_index)
        line.new(bar_index, sl_l, bar_index + 8, sl_l, color=col_sl, width=2, xloc=xloc.bar_index)
        label.new(bar_index + 8, sl_l, "SL " + str.tostring(math.round(sl_l, 2)), color=col_sl, textcolor=color.white, style=label.style_label_left, size=size.small)
        line.new(bar_index, tp_l, bar_index + 8, tp_l, color=col_tp, width=2, xloc=xloc.bar_index)
        label.new(bar_index + 8, tp_l, "TP " + str.tostring(math.round(tp_l, 2)), color=col_tp, textcolor=color.black, style=label.style_label_left, size=size.small)
        box.new(bar_index, sl_l, bar_index + 8, tp_l, border_color=color.new(#FFFFFF, 90), bgcolor=color.new(#00E5A0, 93), xloc=xloc.bar_index)

if show_panel and barstate.islast
    var table panel = table.new(position.top_right, 3, 9, bgcolor=color.new(#0D1117, 85), border_color=color.new(#30363D, 60), border_width=1, frame_color=color.new(#30363D, 60), frame_width=1)
    table.cell(panel, 0, 0, "SMC SETUP",  text_color=color.white, text_size=size.small, bgcolor=color.new(#161B22, 60))
    table.cell(panel, 1, 0, "🔴 SHORT",   text_color=col_short,   text_size=size.small, bgcolor=color.new(#161B22, 60))
    table.cell(panel, 2, 0, "🟢 LONG",    text_color=col_long,    text_size=size.small, bgcolor=color.new(#161B22, 60))
    trend_s_txt = trend_bear ? "✅ AKTIV" : trend_neu ? "⚠️ NEUTRAL" : "🚫 BLOCK"
    trend_l_txt = trend_bull ? "✅ AKTIV" : trend_neu ? "⚠️ NEUTRAL" : "🚫 BLOCK"
    trend_s_col = trend_bear ? col_ok : trend_neu ? col_warn : col_no
    trend_l_col = trend_bull ? col_ok : trend_neu ? col_warn : col_no
    table.cell(panel, 0, 1, "Trend EMA",  text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 1, trend_s_txt,  text_color=trend_s_col, text_size=size.tiny)
    table.cell(panel, 2, 1, trend_l_txt,  text_color=trend_l_col, text_size=size.tiny)
    table.cell(panel, 0, 2, "CHoCH/BOS",  text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 2, struct_bear ? "✅" : "❌", text_color=struct_bear ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 2, 2, struct_bull ? "✅" : "❌", text_color=struct_bull ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 0, 3, "FVG Zone",   text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 3, fvg_bear_cond ? "✅" : "❌", text_color=fvg_bear_cond ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 2, 3, fvg_bull_cond ? "✅" : "❌", text_color=fvg_bull_cond ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 0, 4, "Vol. Spike", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 4, vol_spike_bear ? "✅" : "❌", text_color=vol_spike_bear ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 2, 4, vol_spike_bull ? "✅" : "❌", text_color=vol_spike_bull ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 0, 5, "Rej. Wick",  text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 5, rejection_bear ? "✅" : "❌", text_color=rejection_bear ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 2, 5, rejection_bull ? "✅" : "❌", text_color=rejection_bull ? col_ok : col_no, text_size=size.tiny)
    table.cell(panel, 0, 6, "─────────────", text_color=col_neu, text_size=size.tiny)
    table.cell(panel, 1, 6, "───────",       text_color=col_neu, text_size=size.tiny)
    table.cell(panel, 2, 6, "───────",       text_color=col_neu, text_size=size.tiny)
    s_col = score_short >= min_score ? col_ok : score_short == min_score - 1 ? col_warn : col_no
    l_col = score_long  >= min_score ? col_ok : score_long  == min_score - 1 ? col_warn : col_no
    table.cell(panel, 0, 7, "SCORE", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 7, str.tostring(score_short) + " / 4", text_color=s_col, text_size=size.small)
    table.cell(panel, 2, 7, str.tostring(score_long)  + " / 4", text_color=l_col, text_size=size.small)
    s_sig = score_short >= min_score ? "🔴 ENTRY!" : score_short == min_score - 1 ? "⚠️ WARTEN" : "🚫 KEIN"
    l_sig = score_long  >= min_score ? "🟢 ENTRY!" : score_long  == min_score - 1 ? "⚠️ WARTEN" : "🚫 KEIN"
    table.cell(panel, 0, 8, "SIGNAL", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 8, s_sig, text_color=s_col, text_size=size.small)
    table.cell(panel, 2, 8, l_sig, text_color=l_col, text_size=size.small)